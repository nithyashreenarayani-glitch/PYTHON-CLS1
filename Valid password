def minChangesToValidPassword(password):
    chars = list(password)
    operations = 0
    i = 1
    
    while i < len(chars):
        if chars[i] == chars[i - 1]:
            operations += 1
            # Pick a character that doesn't match the previous one,
            # and if there is a next character, doesn't match that either.
            replacement = 'a'
            while replacement == chars[i - 1] or (i + 1 < len(chars) and replacement == chars[i + 1]):
                replacement = chr(ord(replacement) + 1)
            chars[i] = replacement
        i += 1
        
    return operations

if __name__ == '__main__':
    fptr = open(os.environ['OUTPUT_PATH'], 'w')

    password = input()

    result = minChangesToValidPassword(password)

    fptr.write(str(result) + '\n')

    fptr.close()
