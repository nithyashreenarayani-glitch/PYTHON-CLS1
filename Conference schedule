# Complete the 'maxPresentations' function below.
#
# The function is expected to return an INTEGER.
# The function accepts following parameters:
#  1. INTEGER_ARRAY scheduleStart
#  2. INTEGER_ARRAY scheduleEnd
#

def maxPresentations(scheduleStart, scheduleEnd):
    # Zip start and end times together into pairs (intervals)
    presentations = list(zip(scheduleStart, scheduleEnd))
    
    # Sort presentations based on their end times (and then start times)
    presentations.sort(key=lambda x: x[1])
    
    count = 0
    last_end_time = -1
    
    for start, end in presentations:
        # If the presentation starts at or after the last attended one ends
        if start >= last_end_time:
            count += 1
            last_end_time = end  # Update the end time to the current presentation's end
            
    return count

if __name__ == '__main__':
    fptr = open(os.environ['OUTPUT_PATH'], 'w')

